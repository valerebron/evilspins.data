{
  "name": "evilspins-data",
  "version": "1.0.0",
  "description": "data API for EvilSpins music card app",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "db": "docker compose -f dev.database.yml up -d",
    "db:down": "docker compose -f dev.database.yml down && docker volume rm evilspinsdata_postgres_data",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/src/index.js",
    "scan": "ts-node src/scanner/index.ts"
  },
  "dependencies": {
    "blurhash": "^2.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
